---
import Base from '../layouts/Base.astro';
import { type Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const principles = [
  { term: t('principles.practical.term'), detail: t('principles.practical.detail') },
  { term: t('principles.neutral.term'), detail: t('principles.neutral.detail') },
  { term: t('principles.declarative.term'), detail: t('principles.declarative.detail') },
];

// One entry today; the list is shaped to take more without changing layout.
// Project and technology names are not translated.
const projects = [
  {
    name: 'ZoneRoute',
    summary: t('projects.zoneroute.summary'),
    detail: t('projects.zoneroute.detail'),
    stack: ['Go', 'Kubernetes', 'CoreDNS'],
    site: 'https://zoneroute.mihnk.org',
    repo: 'https://github.com/mihnk/zoneroute',
  },
];
---

<Base locale={locale} path="" title={t('site.title')} description={t('site.description')}>
  <h1 class="headline">
    <span>
      {t('home.headline.1.accent') && <em>{t('home.headline.1.accent')}</em>}
      {t('home.headline.1.rest')}
    </span>
    <span>
      {t('home.headline.2.accent') && <em>{t('home.headline.2.accent')}</em>}
      {t('home.headline.2.rest')}
    </span>
    <span>{t('home.headline.3')}</span>
  </h1>

  <div class="lede">
    <p class="description">{t('home.description')}</p>

    <ul class="links">
      <li>
        <a class="link" href="https://github.com/mihnk" rel="noopener noreferrer">
          {t('nav.github')}
          <span class="arrow" aria-hidden="true">
            &#8599;
          </span>
        </a>
      </li>
      <li>
        <a class="link" href="mailto:contact@mihnk.org">
          {t('nav.contact')}
          <span class="arrow" aria-hidden="true">
            &#8599;
          </span>
        </a>
      </li>
    </ul>
  </div>

  <ol class="principles" aria-label={t('principles.label')}>
    {principles.map(({ term, detail }, i) => (
      <li class="principle">
        <span class="principle-index" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h2 class="principle-term">{term}</h2>
        <p class="principle-detail">{detail}</p>
      </li>
    ))}
  </ol>

  <section class="projects" aria-labelledby="projects-heading">
    <h2 class="projects-label" id="projects-heading">
      {t('projects.label')}
    </h2>

    <ul class="project-list">
      {projects.map((project) => (
        <li class="project">
          <h3 class="project-name">{project.name}</h3>
          <p class="project-summary">{project.summary}</p>
          <p class="project-detail">{project.detail}</p>
          <p class="project-stack">{project.stack.join(' · ')}</p>

          <ul class="links project-links">
            <li>
              <a class="link" href={project.site} rel="noopener noreferrer">
                {t('projects.view')}
                <span class="arrow" aria-hidden="true">
                  &#8599;
                </span>
              </a>
            </li>
            <li>
              <a class="link" href={project.repo} rel="noopener noreferrer">
                {t('nav.github')}
                <span class="arrow" aria-hidden="true">
                  &#8599;
                </span>
              </a>
            </li>
          </ul>
        </li>
      ))}
    </ul>
  </section>
</Base>
